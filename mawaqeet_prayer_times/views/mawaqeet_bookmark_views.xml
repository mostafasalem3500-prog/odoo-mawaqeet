<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mawaqeet_bookmark_view_list" model="ir.ui.view">
        <field name="name">mawaqeet.bookmark.list</field>
        <field name="model">mawaqeet.bookmark</field>
        <field name="arch" type="xml">
            <list string="My Bookmarks">
                <field name="name"/>
                <field name="kind"/>
                <field name="excerpt"/>
                <field name="note" optional="show"/>
                <field name="create_date" string="Added on" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="mawaqeet_bookmark_view_form" model="ir.ui.view">
        <field name="name">mawaqeet.bookmark.form</field>
        <field name="model">mawaqeet.bookmark</field>
        <field name="arch" type="xml">
            <form string="Bookmark">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="sura" invisible="kind != 'ayah'"/>
                            <field name="ayah" invisible="kind != 'ayah'"/>
                            <field name="book" invisible="kind != 'hadith'"/>
                            <field name="number" invisible="kind != 'hadith'"/>
                        </group>
                    </group>
                    <field name="excerpt" readonly="1" class="o_mawaqeet_excerpt"/>
                    <separator string="My Note"/>
                    <field name="note" placeholder="Write a reflection or reminder..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mawaqeet_bookmark_view_search" model="ir.ui.view">
        <field name="name">mawaqeet.bookmark.search</field>
        <field name="model">mawaqeet.bookmark</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="excerpt"/>
                <field name="note"/>
                <filter name="f_ayah" string="Quran Verses" domain="[('kind', '=', 'ayah')]"/>
                <filter name="f_hadith" string="Hadiths" domain="[('kind', '=', 'hadith')]"/>
                <group>
                    <filter name="g_kind" string="Type" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_mawaqeet_bookmarks" model="ir.actions.act_window">
        <field name="name">My Bookmarks</field>
        <field name="res_model">mawaqeet.bookmark</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bookmarks yet</p>
            <p>Tap the bookmark icon next to any verse or hadith to save it here.</p>
        </field>
    </record>
</odoo>
